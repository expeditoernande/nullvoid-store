# Banco dos pedidos (Vercel injeta POSTGRES_URL ao conectar um Postgres no projeto).
# Sem essa variável o checkout ainda funciona, mas os pedidos não sobrevivem
# entre requisições na Vercel (o dev local grava em .nullvoid-orders.json).
POSTGRES_URL=

# Opcional: caminho do arquivo usado como armazenamento de pedidos no dev.
# NULLVOID_ORDERS_FILE=.nullvoid-orders.json